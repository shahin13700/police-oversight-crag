# ── OpenRouter (dev/eval LLM + embeddings) ──────────────────────────────────────
# Get your key at https://openrouter.ai
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=qwen/qwen3.5-plus-02-15
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# ── Groq (demo/prod LLM) ────────────────────────────────────────────────────────
# Get your free key at https://console.groq.com
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Production API URL (app_prod.py only) ───────────────────────────────────────
# Set to FastAPI backend URL when deploying to Azure
# Leave as default for local testing with two terminals
API_URL=http://localhost:8000

# ── Embedding Model ─────────────────────────────────────────────────────────────
EMBEDDING_MODEL=openai/text-embedding-3-small

# ── ChromaDB ────────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=ontario_legislation

# ── Data Paths ──────────────────────────────────────────────────────────────────
RAW_DATA_DIR=data/raw

# ── Retrieval Settings ──────────────────────────────────────────────────────────
TOP_K_VECTOR=10
TOP_K_BM25=10
TOP_K_FINAL=5
COHERE_API_KEY=your-cohere-key-here
COHERE_RERANK_MODEL=rerank-v4.0-fast
RERANKER_TOP_N=5
